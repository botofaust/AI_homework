	И я нажимаю на кнопку с именем "КнопкаЗагрузить"
	Тогда элемент формы с именем "Сообщения" стал равен "Счет создан без проведения."
	И я сохраняю скриншот "D:\work_projects\AI_edu\var\screenshots\invoice-exchange\run-20261117-01\screenshots\04-import-created.png"
	И я выполняю код встроенного языка на сервере
	"""bsl
	Текст = Новый ТекстовыйДокумент;
	Текст.Прочитать("D:\work_projects\AI_edu\var\screenshots\invoice-exchange\run-20261117-01\data\invoice.json", КодировкаТекста.UTF8);
	Разбор = ФОС_ОбменСчетамиСервер.РазобратьФайл(Текст.ПолучитьТекст());
	Если Разбор.Ошибки.Количество() > 0 Тогда ВызватьИсключение СтрСоединить(Разбор.Ошибки, Символы.ПС); КонецЕсли;
	Данные = Разбор.Данные;
	Счет = Документы._ДемоСчетНаОплатуПокупателю.ПолучитьСсылку(Данные.UUID).ПолучитьОбъект();
	Если Счет = Неопределено Тогда ВызватьИсключение "Нет счета по UUID файла"; КонецЕсли;
	Если Счет.Проведен Тогда ВызватьИсключение "Загруженный счет проведен"; КонецЕсли;
	Для Каждого Поле Из Данные Цикл
		Если Поле.Ключ = "UUID" Или Поле.Ключ = "Товары" Тогда Продолжить; КонецЕсли;
		Если Счет[Поле.Ключ] <> Поле.Значение Тогда ВызватьИсключение "Не совпадает шапка: " + Поле.Ключ; КонецЕсли;
	КонецЦикла;
	Если Счет.Товары.Количество() <> Данные.Товары.Количество() Тогда ВызватьИсключение "Не совпадает число строк"; КонецЕсли;
	Для НомерСтроки = 0 По Данные.Товары.Количество() - 1 Цикл
		Для Каждого Поле Из Данные.Товары[НомерСтроки] Цикл
			Если Счет.Товары[НомерСтроки][Поле.Ключ] <> Поле.Значение Тогда ВызватьИсключение "Не совпадает товар: " + Поле.Ключ; КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Текст.УстановитьТекст("PASS: UUID, шапка, товары и отсутствие проведения совпадают с файлом");
	Текст.Записать("D:\work_projects\AI_edu\var\screenshots\invoice-exchange\run-20261117-01\data\target-create-verified.txt", КодировкаТекста.UTF8);

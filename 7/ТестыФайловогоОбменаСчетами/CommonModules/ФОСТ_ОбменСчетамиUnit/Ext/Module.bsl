#Область РегистрацияТестов

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты.ДобавитьТестовыйНабор("Файловый обмен: unit", "Unit")
		.ДобавитьТест("НекорректныйJSONОтклоняется")
		.ДобавитьТест("НеизвестныйФорматОтклоняется")
		.ДобавитьТест("НеподдерживаемаяВерсияОтклоняется")
		.ДобавитьТест("ОтсутствующийРеквизитШапкиОтклоняется")
		.ДобавитьТест("НеизвестноеПолеКорняОтклоняется");

КонецПроцедуры

#КонецОбласти

#Область Тесты

Процедура НекорректныйJSONОтклоняется() Экспорт

	Результат = ФОС_ОбменСчетамиСервер.РазобратьФайл("{");

	ЮТест.ОжидаетЧто(Результат.Данные).ЭтоНеопределено();
	ЮТест.ОжидаетЧто(Результат.Ошибки.Количество()).Равно(1);
	ЮТест.ОжидаетЧто(Результат.Ошибки[0]).НачинаетсяС("Не удалось прочитать JSON:");
	ЮТест.ОжидаетЧто(Результат.Представление).Равно("{");

КонецПроцедуры

Процедура НеизвестныйФорматОтклоняется() Экспорт

	// invoice намеренно не объект: разбор завершится до метаданных и обращений к ИБ.
	Результат = ФОС_ОбменСчетамиСервер.РазобратьФайл(
		"{""format"":""order"",""version"":1,""invoice"":null}");

	ПроверитьОтказ(Результат, "Неподдерживаемый формат: ожидается format = invoice.", 2);

КонецПроцедуры

Процедура НеподдерживаемаяВерсияОтклоняется() Экспорт

	Результат = ФОС_ОбменСчетамиСервер.РазобратьФайл(
		"{""format"":""invoice"",""version"":2,""invoice"":null}");

	ПроверитьОтказ(Результат, "Неподдерживаемая версия: ожидается version = 1.", 2);

КонецПроцедуры

Процедура ОтсутствующийРеквизитШапкиОтклоняется() Экспорт

	// Все поля присутствуют, кроме Комментария. Их значения не читаются на этом этапе.
	Счет = Новый Структура;
	Поля = СтрРазделить("UUID,Номер,Дата,БанковскийСчет,ВалютаДокумента,ВидСкидкиНаценки,"
		+ "ДатаОплаты,Договор,Основание,КолонкаПрайсЛиста,Партнер,Контрагент,Кратность,Курс,"
		+ "Организация,Ответственный,Подразделение,ПрайсЛист,ПроцентОплаты,СуммаВключаетНДС,"
		+ "СуммаОплаты,Товары", ",");
	Для Каждого Имя Из Поля Цикл
		Счет.Вставить(Имя, Неопределено);
	КонецЦикла;
	Контейнер = Новый Структура("format,version,invoice", "invoice", 1, Счет);
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Контейнер);

	Результат = ФОС_ОбменСчетамиСервер.РазобратьФайл(Запись.Закрыть());

	ПроверитьОтказ(Результат, "invoice: отсутствует поле Комментарий.");

КонецПроцедуры

Процедура НеизвестноеПолеКорняОтклоняется() Экспорт

	Результат = ФОС_ОбменСчетамиСервер.РазобратьФайл(
		"{""format"":""invoice"",""version"":1,""invoice"":null,""extra"":true}");

	ПроверитьОтказ(Результат, "Файл: неизвестное поле extra.");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьОтказ(Результат, Сообщение, КоличествоОшибок = 1)

	ЮТест.ОжидаетЧто(Результат.Данные).ЭтоНеопределено();
	ЮТест.ОжидаетЧто(Результат.Ошибки.Количество()).Равно(КоличествоОшибок);
	ЮТест.ОжидаетЧто(Результат.Ошибки).Содержит(Сообщение);

КонецПроцедуры

#КонецОбласти

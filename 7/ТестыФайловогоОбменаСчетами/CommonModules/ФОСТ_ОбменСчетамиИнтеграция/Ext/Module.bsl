#Область РегистрацияТестов

Процедура ИсполняемыеСценарии() Экспорт

	// Вложенная фиксация в ЗагрузитьФайл не фиксирует внешнюю транзакцию YAxUnit.
	ЮТТесты.ДобавитьТестовыйНабор("Файловый обмен: интеграция", "Integration")
		.ВТранзакции()
		.ДобавитьТест("ЗагрузкаСоздаетСчетИСохраняетДанные")
		.ДобавитьТест("ПовторнаяЗагрузкаЗаменяетДанныеБезДубликата");

КонецПроцедуры

#КонецОбласти

#Область Тесты

Процедура ЗагрузкаСоздаетСчетИСохраняетДанные() Экспорт

	Контейнер = ПодготовитьФайлНовогоСчета();
	ТекстJSON = ЗаписатьКонтейнер(Контейнер);

	Результат = ФОС_ОбменСчетамиСервер.ЗагрузитьФайл(ТекстJSON);

	ПроверитьУспешнуюЗагрузку(Результат, Истина);
	ПроверитьЗаписанныйСчет(Результат.Ссылка, Контейнер);
	ЮТест.ОжидаетЧто(Результат.Ссылка.ПолучитьОбъект().Товары.Количество()).Равно(2);

КонецПроцедуры

Процедура ПовторнаяЗагрузкаЗаменяетДанныеБезДубликата() Экспорт

	Контейнер = ПодготовитьФайлНовогоСчета();
	Создание = ФОС_ОбменСчетамиСервер.ЗагрузитьФайл(ЗаписатьКонтейнер(Контейнер));
	ПроверитьУспешнуюЗагрузку(Создание, Истина);
	ЮТест.ОжидаетЧто(Создание.Ссылка.ПолучитьОбъект().Товары.Количество()).Равно(2);
	Контейнер.invoice.Комментарий = "YAxUnit: измененный комментарий";
	Контейнер.invoice.СуммаОплаты = 17.25;
	Контейнер.invoice.Товары.Удалить(1);
	СтрокаТоваров = Контейнер.invoice.Товары[0];
	СтрокаТоваров.Количество = 3;
	СтрокаТоваров.Цена = 20;
	// Намеренно не равны произведению количества и цены: обмен не должен пересчитывать суммы.
	СтрокаТоваров.Сумма = 57.25;
	СтрокаТоваров.СуммаНДС = 7.25;
	СтрокаТоваров.Всего = 64.50;
	ТекстJSON = ЗаписатьКонтейнер(Контейнер);

	Обновление = ФОС_ОбменСчетамиСервер.ЗагрузитьФайл(ТекстJSON);

	ПроверитьУспешнуюЗагрузку(Обновление, Ложь);
	ЮТест.ОжидаетЧто(Обновление.Ссылка).Равно(Создание.Ссылка);
	ПроверитьЗаписанныйСчет(Обновление.Ссылка, Контейнер);
	ЮТест.ОжидаетЧто(Обновление.Ссылка.ПолучитьОбъект().Товары.Количество()).Равно(1);

	Повтор = ФОС_ОбменСчетамиСервер.ЗагрузитьФайл(ТекстJSON);

	ПроверитьУспешнуюЗагрузку(Повтор, Ложь);
	ЮТест.ОжидаетЧто(Повтор.Ссылка).Равно(Создание.Ссылка);
	ПроверитьЗаписанныйСчет(Повтор.Ссылка, Контейнер);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПодготовитьФайлНовогоСчета()

	// Защита от запуска метода напрямую, минуя транзакционную регистрацию YAxUnit.
	Если Не ТранзакцияАктивна() Тогда
		ВызватьИсключение "Интеграционный тест должен выполняться в транзакции YAxUnit.";
	КонецЕсли;

	// Существующие документы и справочники используются только для чтения.
	Запрос = Новый Запрос(
		"ВЫБРАТЬ Счета.Ссылка
		|ИЗ Документ._ДемоСчетНаОплатуПокупателю КАК Счета
		|ГДЕ НЕ Счета.ПометкаУдаления
		| И Счета.Ссылка В
		| (ВЫБРАТЬ Товары.Ссылка ИЗ Документ._ДемоСчетНаОплатуПокупателю.Товары КАК Товары)
		|УПОРЯДОЧИТЬ ПО Счета.Дата УБЫВ");
	Выборка = Запрос.Выполнить().Выбрать();
	Контейнер = Неопределено;
	Пока Выборка.Следующий() Цикл
		ТекстJSON = ФОС_ОбменСчетамиСервер.СформироватьФайл(Выборка.Ссылка);
		Разбор = ФОС_ОбменСчетамиСервер.РазобратьФайл(ТекстJSON);
		Если Разбор.Ошибки.Количество() = 0 Тогда
			Контейнер = ПрочитатьКонтейнер(ТекстJSON);
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если Контейнер = Неопределено Тогда
		ВызватьИсключение "Для интеграционных тестов нужен корректный сохраненный демосчет с товарами и существующими ссылками.";
	КонецЕсли;

	Контейнер.invoice.UUID = Строка(Новый УникальныйИдентификатор);
	Контейнер.invoice.Номер = СвободныйНомер(Контейнер.invoice.Дата);
	Контейнер.invoice.Комментарий = "YAxUnit: новый счет";
	Контейнер.invoice.СуммаОплаты = 12.34;
	СтрокаТоваров = Контейнер.invoice.Товары[0];
	СтрокаТоваров.Количество = 2;
	СтрокаТоваров.Цена = 10;
	СтрокаТоваров.Сумма = 19.50;
	СтрокаТоваров.СуммаНДС = 1.50;
	СтрокаТоваров.Всего = 21;
	// Две независимые структуры; при обновлении тест проверит удаление второй строки.
	ВтораяСтрока = Новый Структура;
	Для Каждого Поле Из СтрокаТоваров Цикл
		ВтораяСтрока.Вставить(Поле.Ключ, Поле.Значение);
	КонецЦикла;
	Контейнер.invoice.Товары.Очистить();
	Контейнер.invoice.Товары.Добавить(СтрокаТоваров);
	Контейнер.invoice.Товары.Добавить(ВтораяСтрока);
	Возврат Контейнер;

КонецФункции

Функция СвободныйНомер(ДатаJSON)

	ДатаСчета = XMLЗначение(Тип("Дата"), ДатаJSON);
	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1 Счета.Ссылка
		|ИЗ Документ._ДемоСчетНаОплатуПокупателю КАК Счета
		|ГДЕ Счета.Номер = &Номер
		| И Счета.Дата МЕЖДУ &НачалоГода И &КонецГода");
	Запрос.УстановитьПараметр("НачалоГода", НачалоГода(ДатаСчета));
	Запрос.УстановитьПараметр("КонецГода", КонецГода(ДатаСчета));
	Для ПопыткаНомера = 1 По 10 Цикл
		Номер = "ЮТ" + Лев(СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", ""), 9);
		Запрос.УстановитьПараметр("Номер", Номер);
		Если Запрос.Выполнить().Пустой() Тогда
			Возврат Номер;
		КонецЕсли;
	КонецЦикла;
	ВызватьИсключение "Не удалось подобрать свободный номер тестового счета.";

КонецФункции

Процедура ПроверитьУспешнуюЗагрузку(Результат, ОжидаетсяСоздание)

	ЮТест.ОжидаетЧто(Результат.Ошибки.Количество()).Равно(0, СтрСоединить(Результат.Ошибки, Символы.ПС));
	ЮТест.ОжидаетЧто(Результат.Создан).Равно(ОжидаетсяСоздание);
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Результат.Ссылка)).ЭтоИстина();

КонецПроцедуры

Процедура ПроверитьЗаписанныйСчет(Ссылка, Контейнер)

	Счет = Ссылка.ПолучитьОбъект();
	ЮТест.ОжидаетЧто(Строка(Ссылка.УникальныйИдентификатор())).Равно(Контейнер.invoice.UUID);
	ЮТест.ОжидаетЧто(Счет.Номер).Равно(Контейнер.invoice.Номер);
	ЮТест.ОжидаетЧто(XMLСтрока(Счет.Дата)).Равно(Контейнер.invoice.Дата);
	ЮТест.ОжидаетЧто(Счет.Комментарий).Равно(Контейнер.invoice.Комментарий);
	ЮТест.ОжидаетЧто(Счет.СуммаОплаты).Равно(Контейнер.invoice.СуммаОплаты);
	ЮТест.ОжидаетЧто(Счет.Проведен).ЭтоЛожь();
	// Сравнение всего контракта: 19 реквизитов шапки и все колонки каждой строки.
	ФактическийКонтейнер = ПрочитатьКонтейнер(ФОС_ОбменСчетамиСервер.СформироватьФайл(Ссылка));
	ЮТест.ОжидаетЧто(ФактическийКонтейнер).Равно(Контейнер);

КонецПроцедуры

Функция ПрочитатьКонтейнер(ТекстJSON)

	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(ТекстJSON);
	Результат = ПрочитатьJSON(Чтение);
	Чтение.Закрыть();
	Возврат Результат;

КонецФункции

Функция ЗаписатьКонтейнер(Контейнер)

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Контейнер);
	Возврат Запись.Закрыть();

КонецФункции

#КонецОбласти
